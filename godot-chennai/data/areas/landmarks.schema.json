{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chennai landmark shortlist (G-200)",
  "type": "object",
  "required": ["format", "decision", "landmarks", "tier_counts", "sources"],
  "properties": {
    "format": {"const": 1},
    "decision": {"const": "G-200"},
    "landmarks": {"type": "array", "minItems": 80, "items": {"$ref": "#/$defs/landmark"}},
    "tier_counts": {"type": "object", "required": ["A", "B", "C"]},
    "sources": {"type": "array", "items": {"type": "object", "required": ["url", "title", "licence"]}}
  },
  "$defs": {
    "url": {"type": "string", "pattern": "^https://"},
    "status": {"enum": ["sourced", "osm", "estimated", "unverified"]},
    "claim": {"type": "object", "required": ["text", "status"], "properties": {"text": {"type": "string", "minLength": 8}, "status": {"$ref": "#/$defs/status"}, "source": {"anyOf": [{"$ref": "#/$defs/url"}, {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/url"}}]}, "basis": {"type": "string"}, "note": {"type": "string"}}},
    "valueclaim": {"type": ["object", "null"], "properties": {"value": {"type": "number"}, "status": {"$ref": "#/$defs/status"}, "source": {"type": ["string", "null"]}, "basis": {"type": "string"}}},
    "landmark": {
      "type": "object",
      "required": ["id", "names", "area", "kind", "tier", "osm", "style", "features", "photos"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "names": {"type": "object", "required": ["en", "ta"], "properties": {"en": {"type": "string", "minLength": 3}, "ta": {"type": "object", "required": ["value", "status", "note"], "properties": {"value": {"type": ["string", "null"]}, "status": {"enum": ["osm", "unverified"]}, "note": {"type": "string", "pattern": "native review|withheld"}}}}},
        "area": {"type": "string"},
        "kind": {"type": "string", "minLength": 3},
        "tier": {"type": "object", "required": ["tier", "reason"], "properties": {"tier": {"enum": ["A", "B", "C"]}, "reason": {"type": "string", "minLength": 20}, "params": {"type": "object"}}},
        "osm": {"type": "object", "required": ["found"], "properties": {"found": {"type": "boolean"}, "type": {"enum": ["node", "way", "relation"]}, "id": {"type": "integer"}, "url": {"$ref": "#/$defs/url"}, "lat": {"type": "number", "minimum": 12, "maximum": 14}, "lng": {"type": "number", "minimum": 79, "maximum": 81}, "x": {"type": "number"}, "z": {"type": "number"}, "geometry": {"enum": ["polygon", "line", "node"]}}},
        "research_name": {"type": "object", "required": ["value", "marked"]},
        "sign": {"type": "object", "required": ["ta", "en"]},
        "wikidata": {"type": ["string", "null"], "pattern": "^Q[0-9]+$"},
        "levels": {"$ref": "#/$defs/valueclaim"},
        "height_m": {"$ref": "#/$defs/valueclaim"},
        "style": {"type": "string", "minLength": 3},
        "features": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
        "photos": {"type": "object", "required": ["commons_files"], "properties": {"commons_files": {"type": "array", "maxItems": 3, "items": {"type": "object", "required": ["title", "licence"], "properties": {"title": {"type": "string", "pattern": "^File:"}, "licence": {"type": "string"}, "author": {"type": ["string", "null"]}}}}}}
      }
    }
  }
}
