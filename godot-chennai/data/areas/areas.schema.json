{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chennai areas (G-200)",
  "type": "object",
  "required": ["format", "decision", "claim_status", "areas", "sources"],
  "properties": {
    "format": {"const": 1},
    "decision": {"const": "G-200"},
    "generated": {"type": "string"},
    "licence_of_this_file": {"type": "string"},
    "claim_status": {"type": "object"},
    "areas": {"type": "array", "minItems": 30, "items": {"$ref": "#/$defs/area"}},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}
  },
  "$defs": {
    "hex": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "url": {"type": "string", "pattern": "^https://"},
    "source": {"type": "object", "required": ["url", "title", "licence"], "properties": {"url": {"$ref": "#/$defs/url"}, "title": {"type": "string", "minLength": 3}, "licence": {"type": "string", "minLength": 3}}},
    "status": {"enum": ["sourced", "osm", "estimated", "unverified"]},
    "claim": {
      "type": "object",
      "required": ["text", "status"],
      "properties": {
        "text": {"type": "string", "minLength": 8},
        "status": {"$ref": "#/$defs/status"},
        "source": {"anyOf": [{"$ref": "#/$defs/url"}, {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/url"}}]},
        "basis": {"type": "string", "minLength": 8},
        "note": {"type": "string"}
      }
    },
    "weights6": {
      "type": "object",
      "required": ["1", "2", "3", "4-5", "6-9", "10+"],
      "additionalProperties": false,
      "properties": {"1": {"type": "number", "minimum": 0, "maximum": 1}, "2": {"type": "number", "minimum": 0, "maximum": 1}, "3": {"type": "number", "minimum": 0, "maximum": 1}, "4-5": {"type": "number", "minimum": 0, "maximum": 1}, "6-9": {"type": "number", "minimum": 0, "maximum": 1}, "10+": {"type": "number", "minimum": 0, "maximum": 1}}
    },
    "boundary": {
      "type": "object",
      "required": ["type", "basis"],
      "properties": {
        "type": {"enum": ["circle", "corridor"]},
        "centre_xz": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "radius_m": {"type": "number", "minimum": 100, "maximum": 6000},
        "spine_xz": {"type": "array", "minItems": 2, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}},
        "half_width_m": {"type": "number", "minimum": 100, "maximum": 6000},
        "basis": {"type": "string", "minLength": 8}
      }
    },
    "area": {
      "type": "object",
      "required": ["id", "names", "centre", "boundary", "character", "storeys", "roofs", "wall_palette", "facade_materials", "street", "trees", "street_life", "signage"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "names": {
          "type": "object",
          "required": ["en", "ta"],
          "properties": {
            "en": {"type": "string", "minLength": 2},
            "alt_en": {"type": "array", "items": {"type": "string"}},
            "ta": {"type": "object", "required": ["value", "status", "note"], "properties": {"value": {"type": ["string", "null"]}, "status": {"enum": ["osm", "unverified"]}, "source": {"anyOf": [{"$ref": "#/$defs/url"}, {"type": "array", "items": {"$ref": "#/$defs/url"}}]}, "note": {"type": "string", "pattern": "needs native review"}}}
          }
        },
        "centre": {"type": "object", "required": ["x", "z", "lat", "lng", "derived_from"], "properties": {"x": {"type": "number"}, "z": {"type": "number"}, "lat": {"type": "number", "minimum": 12, "maximum": 14}, "lng": {"type": "number", "minimum": 79, "maximum": 81}, "derived_from": {"type": "string", "minLength": 8}}},
        "boundary": {"$ref": "#/$defs/boundary"},
        "character": {
          "type": "object",
          "required": ["type", "summary"],
          "properties": {
            "type": {"enum": ["old-commercial", "temple-town", "colonial-institutional", "planned-residential", "dense-market", "IT-corridor", "coastal", "port-industrial", "airport", "suburban", "rural-edge"]},
            "summary": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/claim"}}
          }
        },
        "storeys": {"type": "object", "required": ["min", "max", "typical", "weights", "status", "basis"], "properties": {"min": {"type": "integer", "minimum": 1}, "max": {"type": "integer", "maximum": 60}, "typical": {"type": "integer", "minimum": 1}, "weights": {"$ref": "#/$defs/weights6"}, "status": {"$ref": "#/$defs/status"}, "basis": {"type": "string", "minLength": 8}, "source": {"type": "array", "items": {"$ref": "#/$defs/url"}}}},
        "roofs": {
          "type": "object",
          "required": ["mix", "status", "basis", "colours"],
          "properties": {
            "mix": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["shape", "variant", "weight"], "properties": {"shape": {"enum": ["flat", "gabled", "hipped", "pyramidal", "dome", "skillion", "half-hipped", "gambrel", "mansard", "round", "onion", "cone", "saltbox", "other"]}, "variant": {"type": "string", "minLength": 5}, "weight": {"type": "number", "minimum": 0, "maximum": 1}}}},
            "status": {"$ref": "#/$defs/status"},
            "basis": {"type": "string"},
            "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
            "colours": {"type": "object", "required": ["hex", "status", "basis"], "properties": {"hex": {"type": "array", "minItems": 3, "maxItems": 6, "items": {"$ref": "#/$defs/hex"}}, "status": {"const": "estimated"}, "basis": {"type": "string"}}}
          }
        },
        "wall_palette": {"type": "object", "required": ["colours", "status", "basis"], "properties": {"colours": {"type": "array", "minItems": 6, "maxItems": 8, "items": {"type": "object", "required": ["hex", "name"], "properties": {"hex": {"$ref": "#/$defs/hex"}, "name": {"type": "string", "minLength": 3}}}}, "status": {"const": "estimated"}, "basis": {"type": "string", "minLength": 8}}},
        "facade_materials": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
        "street": {"type": "object", "required": ["width_m", "feel", "claim"], "properties": {"width_m": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 2, "maximum": 60}}, "feel": {"type": "string", "minLength": 8}, "width_status": {"const": "estimated"}, "claim": {"$ref": "#/$defs/claim"}}},
        "trees": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["species_en", "species_sci", "claim"], "properties": {"species_en": {"type": "string"}, "species_sci": {"type": "string"}, "claim": {"$ref": "#/$defs/claim"}}}},
        "street_life": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
        "signage": {"type": "object", "required": ["languages", "mix", "categories", "claim", "no_business_names"], "properties": {"languages": {"type": "array", "minItems": 1, "items": {"enum": ["ta", "en", "hi", "ur", "te"]}}, "mix": {"type": "string", "minLength": 8}, "categories": {"type": "array", "minItems": 2, "items": {"type": "string"}}, "claim": {"$ref": "#/$defs/claim"}, "no_business_names": {"const": true}}}
      }
    }
  }
}
