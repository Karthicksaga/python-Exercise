 "facts": [
  {
   "en": "A Hindu temple of Shiva (as Kapaleeshwarar) and Parvati (as Karpagambal) in Mylapore.",
   "source": "https://en.wikipedia.org/wiki/Kapaleeshwarar_Temple"
  },
  {
   "en": "The east gateway tower, about 120 ft (37 m) tall, was built in 1906; a smaller west gopuram faces the tank.",
   "source": "https://www.ancient-history-sites.com/?p=133412"
  },
  {
   "en": "The temple tank measures about 190 m by 143 m; a sixteen-pillared stone mandapam stands at its centre and is used in the three-day float festival.",
   "source": "https://en.wikipedia.org/wiki/Kapaleeshwarar_Temple"
  },
