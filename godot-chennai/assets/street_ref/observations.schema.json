{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "street_ref observations (G-514)",
 "type": "object",
 "required": [
  "format",
  "area",
  "observations"
 ],
 "properties": {
  "format": {
   "const": 1
  },
  "area": {
   "type": "string"
  },
  "reviewed_by": {
   "type": "string"
  },
  "reviewed_on": {
   "type": "string"
  },
  "observations": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "category",
     "location",
     "facts"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "category": {
      "enum": [
       "residential_house",
       "independent_house",
       "apartment",
       "commercial",
       "retail_shop",
       "office",
       "institutional"
      ]
     },
     "location": {
      "type": "object",
      "required": [
       "lat",
       "lng"
      ]
     },
     "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
       "allOf": [
        {
         "required": [
          "status"
         ],
         "properties": {
          "status": {
           "enum": [
            "observed",
            "estimated"
           ]
          },
          "basis": {
           "const": "general_knowledge"
          },
          "basis_note": {
           "type": "string"
          },
          "sources": {
           "type": "array",
           "minItems": 1,
           "items": {
            "oneOf": [
             {
              "type": "object",
              "required": [
               "provider",
               "image_id"
              ],
              "properties": {
               "provider": {
                "enum": [
                 "mapillary",
                 "kartaview"
                ]
               },
               "image_id": {
                "type": "string"
               }
              },
              "additionalProperties": false
             },
             {
              "type": "object",
              "required": [
               "kind",
               "note",
               "date"
              ],
              "properties": {
               "kind": {
                "const": "human_inspection"
               },
               "note": {
                "type": "string"
               },
               "date": {
                "type": "string"
               }
              },
              "additionalProperties": false
             }
            ]
           }
          }
         },
         "oneOf": [
          {
           "properties": {
            "status": {
             "const": "observed"
            }
           },
           "required": [
            "sources"
           ]
          },
          {
           "properties": {
            "status": {
             "const": "estimated"
            }
           },
           "required": [
            "basis",
            "basis_note"
           ]
          }
         ]
        }
       ],
       "required": [
        "field",
        "value"
       ],
       "properties": {
        "field": {
         "enum": [
          "wall_colour",
          "accent_colour",
          "floors",
          "shop_type",
          "roof_type",
          "roof_colour",
          "wall_style",
          "gate_style",
          "shutter_style",
          "balcony_style",
          "window_style",
          "signboard_slots",
          "compound_wall",
          "sunshade",
          "water_tank"
         ]
        },
        "value": {}
       }
      }
     },
     "notes": {
      "type": "string"
     }
    }
   }
  }
 }
}
