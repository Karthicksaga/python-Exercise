{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "facade categories (G-512)",
 "type": "object",
 "required": [
  "format",
  "categories"
 ],
 "properties": {
  "format": {
   "const": 1
  },
  "categories": {
   "type": "array",
   "minItems": 7,
   "maxItems": 7,
   "items": {
    "type": "object",
    "required": [
     "id",
     "game_kind",
     "fields"
    ],
    "properties": {
     "id": {
      "enum": [
       "residential_house",
       "independent_house",
       "apartment",
       "commercial",
       "retail_shop",
       "office",
       "institutional"
      ]
     },
     "game_kind": {
      "enum": [
       "house",
       "apartments",
       "commercial"
      ]
     },
     "fields": {
      "type": "object",
      "required": [
       "palette",
       "floors",
       "windows",
       "balconies",
       "gates",
       "shutters",
       "signboard_slots",
       "roofs"
      ],
      "additionalProperties": {
       "allOf": [
        {
         "required": [
          "status"
         ],
         "properties": {
          "status": {
           "enum": [
            "observed",
            "estimated"
           ]
          },
          "basis": {
           "const": "general_knowledge"
          },
          "basis_note": {
           "type": "string"
          },
          "sources": {
           "type": "array",
           "minItems": 1,
           "items": {
            "oneOf": [
             {
              "type": "object",
              "required": [
               "provider",
               "image_id"
              ],
              "properties": {
               "provider": {
                "enum": [
                 "mapillary",
                 "kartaview"
                ]
               },
               "image_id": {
                "type": "string"
               }
              },
              "additionalProperties": false
             },
             {
              "type": "object",
              "required": [
               "kind",
               "note",
               "date"
              ],
              "properties": {
               "kind": {
                "const": "human_inspection"
               },
               "note": {
                "type": "string"
               },
               "date": {
                "type": "string"
               }
              },
              "additionalProperties": false
             }
            ]
           }
          }
         },
         "oneOf": [
          {
           "properties": {
            "status": {
             "const": "observed"
            }
           },
           "required": [
            "sources"
           ]
          },
          {
           "properties": {
            "status": {
             "const": "estimated"
            }
           },
           "required": [
            "basis",
            "basis_note"
           ]
          }
         ]
        }
       ],
       "required": [
        "value"
       ]
      }
     }
    }
   }
  }
 }
}
