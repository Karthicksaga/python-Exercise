; Engine configuration file.
; Godot 4.7.2 stable (decision G-1). Edit with care: tests and CI read these settings.

config_version=5

[application]

config/name="Chennai Open World"
config/description="An original open-world game set in real Chennai, for Android phones in landscape."
run/main_scene="res://src/app/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.07, 0.07, 0.08, 1)
boot_splash/show_image=false

[autoload]

GameLoop="*res://src/game_engine/game_loop.gd"
WorldOrigin="*res://src/game_engine/world_origin.gd"
Weather="*res://src/game_engine/environment/weather.gd"
Sound="*res://src/audio/sound.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/unsafe_cast=1

[display]

window/size/viewport_width=915
window/size/viewport_height=412
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/dpi/allow_hidpi=true

[importer_defaults]

scene={
"gltf/embedded_image_handling": 2
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=5
common/physics_interpolation=true

[shader_globals]

city_wetness={
"type": "float",
"value": 0.0
}
city_night={
"type": "float",
"value": 0.0
}

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size.mobile=2048
