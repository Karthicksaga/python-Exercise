[gd_resource type="AudioBusLayout" load_steps=4 format=3]

; The mix (decision G-84, TD-26 of the Three.js game): four family buses into Master, and on
; Master a gentle compressor that keeps a busy junction (engines, horns, a siren) from pumping
; on phone speakers, then a hard limiter at -1 dBFS so nothing clips. Ambience carries a
; low-pass that `Sound` closes when the player is inside a vehicle (the street muffled).

[sub_resource type="AudioEffectCompressor" id="glue"]
resource_name = "Glue"
threshold = -16.0
ratio = 4.0
gain = 0.0
attack_us = 2000.0
release_ms = 200.0

[sub_resource type="AudioEffectHardLimiter" id="limit"]
resource_name = "Limiter"
ceiling_db = -1.0
pre_gain_db = 0.0
release = 0.1

[sub_resource type="AudioEffectLowPassFilter" id="muffle"]
resource_name = "Muffle"
cutoff_hz = 18000.0

