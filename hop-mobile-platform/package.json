{
  "name": "hop-mobile-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:rider": "npm run dev -w @hop-mobile/rider",
    "dev:captain": "npm run dev -w @hop-mobile/captain",
    "build:rider": "npm run build -w @hop-mobile/rider",
    "build:captain": "npm run build -w @hop-mobile/captain",
    "build": "npm run build:rider && npm run build:captain",
    "android:rider": "node scripts/android.mjs rider",
    "android:captain": "node scripts/android.mjs captain",
    "typecheck": "tsc --noEmit -p apps/rider && tsc --noEmit -p apps/captain"
  },
  "workspaces": [
    "apps/*",
    "shared",
    "mobile/*"
  ],
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/google.maps": "^3.66.7",
    "@types/leaflet": "^1.9.22",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
