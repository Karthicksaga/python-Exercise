:80 {
    encode gzip zstd
    @backend path /api /api/* /auth /auth/* /healthz /readyz
    handle @backend {
        reverse_proxy {$BACKEND_UPSTREAM} {
            header_up Host {upstream_hostport}
            header_up X-Hop-App {$HOP_APP}
        }
    }
    handle {
        header {
            X-Content-Type-Options nosniff
            Referrer-Policy strict-origin-when-cross-origin
            X-Frame-Options DENY
            Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.googleapis.com https://*.gstatic.com https://maps.googleapis.com https://maps.gstatic.com https://checkout.razorpay.com blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' https://server.arcgisonline.com https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://*.googleapis.com https://*.gstatic.com https://*.google.com https://*.googleusercontent.com data: blob:; connect-src 'self' https://server.arcgisonline.com https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://*.razorpay.com https://*.googleapis.com https://*.gstatic.com https://*.google.com data: blob:; frame-src https://*.google.com https://api.razorpay.com; font-src 'self' https://fonts.gstatic.com data:; worker-src 'self' blob:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
        @assets path /assets/*
        header @assets Cache-Control "public, max-age=31536000, immutable"
        @entry path / /index.html /sw.js
        header @entry Cache-Control "no-cache"
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
