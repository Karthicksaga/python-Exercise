{
  "name": "hop-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev -w @hop/rider & npm run dev -w @hop/captain & npm run dev -w @hop/admin & wait",
    "build": "npm run build -w @hop/rider && npm run build -w @hop/captain && npm run build -w @hop/admin",
    "typecheck": "tsc --noEmit -p apps/rider && tsc --noEmit -p apps/captain && tsc --noEmit -p apps/admin",
    "format": "prettier --write apps packages",
    "android:rider": "node scripts/android.mjs rider",
    "android:captain": "node scripts/android.mjs captain"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@tabler/icons-react": "^3.49.0",
    "@types/leaflet": "^1.9.22",
    "@vis.gl/react-google-maps": "^1.10.1",
    "leaflet": "^1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/google.maps": "^3.66.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "mobile/*"
  ]
}
