# Copy to .env.docker.local. Existing local services remain untouched.
DATABASE_URL=postgres://USER:PASSWORD@host.docker.internal:55432/DATABASE?sslmode=disable
REDIS_URL=redis://host.docker.internal:56379/0
OIDC_ISSUER=http://auth.hop.localhost:8180/realms/hop-dev
OIDC_CLIENT_ID=hop-web
OIDC_CLIENT_SECRET=
SESSION_KEY=
ROUTING_URL=http://host.docker.internal:8191
GEOCODING_URL=http://host.docker.internal:8191/api/
# Frontend build settings (each app has independent values).
RIDER_MAP_PROVIDER=google
RIDER_GOOGLE_MAPS_API_KEY=
RIDER_GOOGLE_MAP_ID=
CAPTAIN_MAP_PROVIDER=google
CAPTAIN_GOOGLE_MAPS_API_KEY=
CAPTAIN_GOOGLE_MAP_ID=

# Razorpay / Online Payment Gateway
# Test mode keys start with 'rzp_test_' and live keys start with 'rzp_live_'
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
DEV_PAYMENTS=true

