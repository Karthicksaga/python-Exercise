# Build backend on a trusted CI runner first; see docs/DEPLOYMENT.md.
FROM golang:1.27.3-alpine AS certificates
FROM scratch
WORKDIR /app
COPY --from=certificates /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --chmod=0555 build-output/api /app/api
COPY --chmod=0555 backend/migrations /app/migrations
ENV ADDRESS=:8080
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/app/api"]
