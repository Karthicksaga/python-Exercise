# Copy to .env; fill values securely. Never commit the real .env.
PUBLIC_HOST=hop.example.com
CAPTAIN_HOST=captain.hop.example.com
ADMIN_HOST=admin.hop.example.com
PUBLIC_ORIGIN=https://hop.example.com
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Generate at least 32 random characters; stable across deploys, protected in secret storage.
SESSION_KEY=
OIDC_ISSUER=https://identity.example.com/realms/hop
OIDC_CLIENT_ID=hop-web
OIDC_CLIENT_SECRET=
# Your self-hosted or contracted services. No public demo endpoints are assumed.
ROUTING_URL=https://routing.example.com
GEOCODING_URL=https://search.example.com/api/

# Optional: exact ingress-only network CIDRs. Empty means ignore forwarding headers.
TRUSTED_PROXY_CIDRS=

# Optional private media. Production uploads fail closed until BOTH buckets are configured.
# Use distinct private GCS buckets; no keys in this file. Cloud Run uses its runtime identity.
MEDIA_PROFILE_BUCKET=
MEDIA_KYC_BUCKET=

# Razorpay / Online Payment Gateway
# Test mode keys start with 'rzp_test_' and live keys start with 'rzp_live_'
PAYMENT_KEY_ID=rzp_test_TsWK0pVVpyvwJM
PAYMENT_KEY_SECRET=wB7SHobaFz7C9QBzTLo0wKmT
PAYMENT_WEBHOOK_SECRET=hoprider
DEV_PAYMENTS=true


# Hop Circle is opt-in; keep disabled until migration 034 and regression verification.
FEATURE_HOP_CIRCLE=false
